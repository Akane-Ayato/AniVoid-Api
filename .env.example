# ---------- server ----------
PORT=8000
CORS_ORIGINS=*                 # comma separated, or *
ADMIN_TOKEN=change-me          # needed for POST /api/admin/refresh (leave empty to disable the endpoint)

# ---------- official AniKoto public API (the "engine") ----------
UPSTREAM_BASE=https://anikotoapi.site
RATE_LIMIT_REQUESTS=55         # upstream allows 60 / 120s, we stay a bit under
RATE_LIMIT_WINDOW=120
CRAWL_PER_PAGE=100             # upstream max

# ---------- weekly rebuild of completed.json / upcoming.json ----------
ENABLE_SCHEDULER=true
REFRESH_TZ=UTC                 # e.g. Asia/Kolkata -> Sunday 00:00 in that timezone
REFRESH_DAY=sun
REFRESH_HOUR=0
REFRESH_MINUTE=0
CRAWL_ON_STARTUP=true          # crawl on boot ONLY if completed.json / upcoming.json are missing
STALE_AFTER_DAYS=0             # 0 = off. N>0 = also re-crawl on boot if last good crawl is older than N days

# ---------- storage ----------
DATA_DIR=./data
JSON_PRETTY=false              # true = indented JSON files (bigger, easier to read)

# ---------- anikototv.to scraping (search / schedule / random / top-ten) ----------
SITE_MIRRORS=https://anikototv.to,https://anikoto.cz,https://anikoto.me,https://anikoto.net,https://anikototv.se
SCRAPER_API_KEY=               # optional Cloudflare bypass (ScraperAPI)
FLARESOLVERR_URL=              # optional Cloudflare bypass (self-hosted), e.g. http://flaresolverr:8191

# ---------- accounts / community (needs MongoDB, e.g. free Atlas M0) ----------
MONGODB_URI=                   # mongodb+srv://user:pass@cluster.mongodb.net/   (empty = account features disabled)
MONGODB_DB=anivoid
SESSION_SECRET=                # long random string: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_DAYS=30
COOKIE_SECURE=true             # set false only for plain-http local testing
GOOGLE_CLIENT_ID=              # Google Cloud OAuth "Web" client id (empty = Google button hidden)
PROXY_SECRET=                  # same value as PROXY_SECRET on the Vercel frontend (lets it forward the real visitor IP)

# ---------- cache TTLs (seconds) ----------
TTL_SEARCH=300
TTL_SCHEDULE=600
TTL_TOPTEN=600

[Unit]
Description=AniVoid API
After=network-online.target
Wants=network-online.target

[Service]
User=anivoid
WorkingDirectory=/opt/anivoid-api
EnvironmentFile=/opt/anivoid-api/.env
ExecStart=/opt/anivoid-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
